{
  "name": "ag-grid-iot-lab",
  "private": true,
  "version": "1.0.0",
  "description": "A React and TypeScript reference implementation for high-volume IoT telemetry, large historical datasets, and spreadsheet-style editing with AG Grid.",
  "license": "MIT",
  "author": "Serhii Baksheiev",
  "repository": {
    "type": "git",
    "url": "https://github.com/serhii-baksheiev/ag-grid-interview-lab.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint src e2e *.ts *.js",
    "format": "prettier --write src e2e scripts docs/*.md docs/audits/REMEDIATION.md .github/workflows/ci.yml README.md package.json *.ts *.js index.html",
    "format:check": "prettier --check src e2e scripts docs/*.md docs/audits/REMEDIATION.md .github/workflows/ci.yml README.md package.json *.ts *.js index.html",
    "test": "vitest run && npm run test:benchmark",
    "test:unit": "vitest run --exclude '**/*.integration.test.tsx' && npm run test:benchmark",
    "test:benchmark": "node --test scripts/require-abort.test.mjs scripts/bundle-budget.test.mjs scripts/median.test.mjs",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "test:integration": "vitest run src/app",
    "test:e2e": "npm run build && npm run test:e2e:ci",
    "test:e2e:ci": "playwright test"
  },
  "dependencies": {
    "ag-grid-community": "36.1.0",
    "ag-grid-react": "36.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
